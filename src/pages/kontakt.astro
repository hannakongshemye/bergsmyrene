---
import { Image } from "astro:assets";
import SiteLayout from "@layouts/SiteLayout.astro";
import Arrow from "@components/Arrow.astro";
import { getLangFromUrl, localizePath } from "@i18n/ui";
import { site, addressLine, mapsUrl } from "@data/site";

import heroImg from "@assets/kjerre-lave.jpg";

const lang = getLangFromUrl(Astro.url);
const L = (p: string) => localizePath(p, lang);
const action = site.contactFormAction;

const s =
  lang === "en"
    ? {
        eyebrow: "Contact",
        title: "Get in touch",
        lead: "Questions about an order, something you would like us to grow, a visit, or a delivery to your kitchen. Write or call, we answer as soon as we are off the field.",
        heroAlt: "A cart being wheeled past the old barn at Bergsmyrene",
        formTitle: "Send us a message",
        name: "Your name",
        email: "Your email address",
        subject: "What is it about",
        message: "Message",
        send: "Send",
        privacy: "We use what you write only to answer you. Read more in the privacy policy.",
        mailtoNote:
          "The form opens your own email program. Prefer writing directly? Use the address below.",
        directTitle: "Directly",
        visitTitle: "Come by",
        visitBody:
          "The farm shop is self-service and open around the clock, all year. Bergsmyrene 2, 3483 Kana, in Hurum.",
        maps: "Open in Google Maps",
        hours: "Opening hours",
        proTitle: "Restaurant or shop?",
        proBody: "Trade orders go through Dagens, but you are always welcome to call us first.",
        proCta: "For the trade",
        subjects: ["An order", "Something you would like us to grow", "A visit to the farm", "Trade delivery", "Something else"],
      }
    : {
        eyebrow: "Kontakt",
        title: "Ta kontakt",
        lead: "Spørsmål om en bestilling, noe du ønsker at vi skal dyrke, et besøk, eller levering til kjøkkenet ditt. Skriv eller ring, vi svarer så snart vi er av åkeren.",
        heroAlt: "En kjerre trilles forbi den gamle låven på Bergsmyrene",
        formTitle: "Send oss en melding",
        name: "Navnet ditt",
        email: "E-postadressen din",
        subject: "Hva gjelder det",
        message: "Melding",
        send: "Send",
        privacy:
          "Vi bruker det du skriver kun til å svare deg. Les mer i personvernerklæringen.",
        mailtoNote:
          "Skjemaet åpner e-postprogrammet ditt. Vil du heller skrive direkte? Bruk adressen under.",
        directTitle: "Direkte",
        visitTitle: "Stikk innom",
        visitBody:
          "Gårdsbutikken er selvbetjent og åpen hele døgnet, hele året. Bergsmyrene 2, 3483 Kana, i Hurum.",
        maps: "Åpne i Google Maps",
        hours: "Åpningstider",
        proTitle: "Restaurant eller butikk?",
        proBody:
          "Proffbestillinger går gjennom Dagens, men du er alltid velkommen til å ringe oss først.",
        proCta: "For proffkunder",
        subjects: ["En bestilling", "Noe du ønsker at vi dyrker", "Besøk på gården", "Levering til proff", "Noe annet"],
      };
---

<SiteLayout title={s.eyebrow} description={s.lead}>
  <section class="section section--tight">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{s.eyebrow}</p>
      <h1 style="margin-block: var(--sp-3) var(--sp-5); max-width: 14ch;" data-reveal data-reveal-delay="1">
        {s.title}
      </h1>
      <p class="lead" data-reveal data-reveal-delay="2">{s.lead}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="split split--wide-right">
        <div data-reveal>
          <div class="panel">
            <h2 class="card__title">{s.directTitle}</h2>
            <dl class="deflist" style="margin-top: var(--sp-4);">
              <div>
                <dt>{lang === "en" ? "Phone" : "Telefon"}</dt>
                <dd><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></dd>
              </div>
              <div>
                <dt>{lang === "en" ? "Email" : "E-post"}</dt>
                <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
              </div>
              <div>
                <dt>{lang === "en" ? "Address" : "Adresse"}</dt>
                <dd>{addressLine}</dd>
              </div>
              <div>
                <dt>{lang === "en" ? "Org. no." : "Org.nr."}</dt>
                <dd>{site.orgnr}</dd>
              </div>
            </dl>
          </div>

          <div class="panel" style="margin-top: var(--sp-5);">
            <h2 class="card__title">{s.visitTitle}</h2>
            <p class="card__text" style="margin-top: var(--sp-3);">{s.visitBody}</p>
            <p style="margin-top: var(--sp-4); display: flex; gap: var(--sp-3); flex-wrap: wrap;">
              <a class="tlink" href={mapsUrl} rel="noopener" target="_blank">
                {s.maps}<Arrow />
              </a>
            </p>
            <p style="margin-top: var(--sp-4);">
              <a class="tlink" href={L("/besok-oss")}>{s.hours}<Arrow /></a>
            </p>
          </div>

          <div class="panel" style="margin-top: var(--sp-5);">
            <h2 class="card__title">{s.proTitle}</h2>
            <p class="card__text" style="margin-top: var(--sp-3);">{s.proBody}</p>
            <p style="margin-top: var(--sp-4);">
              <a class="tlink" href={L("/proff")}>{s.proCta}<Arrow /></a>
            </p>
          </div>
        </div>

        <div data-reveal data-reveal-delay="1">
          <h2 style="margin-bottom: var(--sp-5);">{s.formTitle}</h2>

          <form
            class="cform"
            method="POST"
            action={action || `mailto:${site.email}`}
            {...(action ? {} : { enctype: "text/plain" })}
          >
            <div class="field">
              <label for="c-name">{s.name}</label>
              <input id="c-name" name="navn" type="text" required autocomplete="name" />
            </div>

            <div class="field">
              <label for="c-email">{s.email}</label>
              <input id="c-email" name="epost" type="email" required autocomplete="email" />
            </div>

            <div class="field">
              <label for="c-subject">{s.subject}</label>
              <select id="c-subject" name="emne">
                {s.subjects.map((o) => <option value={o}>{o}</option>)}
              </select>
            </div>

            <div class="field">
              <label for="c-message">{s.message}</label>
              <textarea id="c-message" name="melding" rows="6" required></textarea>
            </div>

            <button class="btn" type="submit">
              {s.send}<Arrow class="btn__arrow" />
            </button>

            {!action && <p class="formnote">{s.mailtoNote}</p>}
            <p class="formnote">
              <a href={L("/personvern")}>{s.privacy}</a>
            </p>
          </form>
        </div>
      </div>

      <figure class="imgfig" style="margin-top: var(--sp-9);" data-reveal>
        <Image
          src={heroImg}
          alt={s.heroAlt}
          widths={[800, 1400, 2000]}
          sizes="(max-width: 1200px) 94vw, 76rem"
          quality={76}
        />
      </figure>
    </div>
  </section>
</SiteLayout>

<style>
  .cform {
    display: grid;
    gap: var(--sp-4);
    max-width: 34rem;
  }

  .cform .btn {
    justify-self: start;
  }

  .imgfig {
    margin: 0;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--surface-2);
  }

  .imgfig :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 760px) {
    .imgfig {
      aspect-ratio: 3 / 2;
    }
  }
</style>
