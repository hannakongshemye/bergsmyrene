---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import {
  getLangFromUrl,
  localizePath,
  stripLocale,
  useTranslations,
} from "@i18n/ui";
import { site, addressLine } from "@data/site";
import LangToggle from "@components/LangToggle.astro";
import CookieConsent from "@components/CookieConsent.astro";
import Notice from "@components/Notice.astro";
import Analytics from "@components/Analytics.astro";

import "@styles/tokens.css";
import "@styles/base.css";
import "@styles/app.css";

interface Props {
  title: string;
  description: string;
  /** Gjennomsiktig nav over et mørkt helbilde (forsiden) */
  transparentNav?: boolean;
  /** OG-bilde, absolutt eller rot-relativ sti */
  ogImage?: string;
  /** Legg inn ekstra JSON-LD */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  transparentNav = false,
  ogImage = "/og/bergsmyrene-og.jpg",
  jsonLd,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);

const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", Astro.site);
const basePath = stripLocale(Astro.url.pathname);
const altNo = new URL(localizePath(basePath, "no"), Astro.site);
const altEn = new URL(localizePath(basePath, "en"), Astro.site);
const ogUrl = new URL(ogImage, Astro.site);

const fullTitle =
  title === site.name ? `${site.name}. ${site.tagline}` : `${title}. ${site.name}`;

const nav = [
  { href: "/garden", label: t("nav.garden") },
  { href: "/sesongen", label: t("nav.season") },
  { href: "/besok-oss", label: t("nav.visit") },
  { href: "/bestill", label: t("nav.order") },
  { href: "/proff", label: t("nav.pro") },
  { href: "/kontakt", label: t("nav.contact") },
];

const footLegal = [
  { href: "/frakt-og-retur", label: t("shipping.title") },
  { href: "/salgsbetingelser", label: t("terms.title") },
  { href: "/personvern", label: t("privacy.title") },
];

const here = stripLocale(Astro.url.pathname).replace(/\/$/, "") || "/";

const orgLd = {
  "@context": "https://schema.org",
  "@type": "Farm",
  name: site.name,
  legalName: site.legalName,
  url: Astro.site?.toString(),
  telephone: site.phone,
  email: site.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.address.lat,
    longitude: site.address.lon,
  },
  sameAs: [site.social.instagram, site.social.facebook],
  taxID: site.orgnr,
};
---

<!doctype html>
<html lang={lang === "en" ? "en" : "nb"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="nb" href={altNo.href} />
    <link rel="alternate" hreflang="en" href={altEn.href} />
    <link rel="alternate" hreflang="x-default" href={altNo.href} />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogUrl.href} />
    <meta property="og:locale" content={lang === "en" ? "en_GB" : "nb_NO"} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#161a12" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(orgLd)}
    />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }

    <Analytics />
    <ClientRouter />
  </head>

  <body>
    <a class="skip-link" href="#main">{t("skip")}</a>

    <header class={`nav${transparentNav ? "" : " nav--solid"}`} data-nav>
      <a class="nav__brand" href={L("/")}>
        Bergsmyrene <small>g&aring;rd</small>
      </a>

      <ul class="nav__links">
        {
          nav.map((n) => (
            <li>
              <a
                href={L(n.href)}
                aria-current={here === n.href ? "page" : undefined}
              >
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="nav__end">
        <LangToggle />
        <a
          class="nav__cta"
          href={site.shopUrl}
          rel="noopener"
          target="_blank"
        >
          {t("nav.shop")}
        </a>
        <button
          class="burger"
          data-burger
          type="button"
          aria-label={t("nav.open")}
          aria-expanded="false"
          aria-controls="drawer"
        >
          <span></span><span></span>
        </button>
      </div>
    </header>

    <nav class="drawer" id="drawer" data-drawer hidden aria-label={t("nav.main")}>
      {nav.map((n) => <a href={L(n.href)}>{n.label}</a>)}
      <a href={site.shopUrl} rel="noopener" target="_blank">{t("nav.shop")}</a>
    </nav>

    <main id="main" class={transparentNav ? "" : "main--offset"}>
      {!transparentNav && <Notice />}
      <slot />
    </main>

    <footer class="foot" data-dark>
      <div class="wrap">
        <div class="foot__grid">
          <div>
            <p class="foot__wordmark">Bergsmyrene</p>
            <p style="color: var(--on-dark-soft); font-size: var(--fs-sm); max-width: 32ch;">
              {site.tagline}
            </p>
          </div>

          <div>
            <h2>{t("footer.address")}</h2>
            <ul>
              <li style="color: var(--on-dark-soft); font-size: var(--fs-sm);">
                {site.address.street}<br />{site.address.postalCode}{" "}{site.address.city}
              </li>
              <li><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></li>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            </ul>
          </div>

          <div>
            <h2>{t("footer.explore")}</h2>
            <ul>
              {nav.map((n) => <li><a href={L(n.href)}>{n.label}</a></li>)}
              <li><a href={L("/galleri")}>{t("nav.gallery")}</a></li>
            </ul>
          </div>

          <div>
            <h2>{t("footer.legal")}</h2>
            <ul>
              {footLegal.map((n) => <li><a href={L(n.href)}>{n.label}</a></li>)}
              <li>
                <button class="foot__cookiebtn" type="button" data-cookie-settings>
                  {t("footer.cookies")}
                </button>
              </li>
            </ul>
            <h2 style="margin-top: var(--sp-5);">{t("footer.follow")}</h2>
            <ul>
              <li><a href={site.social.instagram} rel="noopener me" target="_blank">Instagram</a></li>
              <li><a href={site.social.facebook} rel="noopener me" target="_blank">Facebook</a></li>
            </ul>
          </div>
        </div>

        <div class="foot__bottom">
          <span>
            &copy; {new Date().getFullYear()} {site.legalName} &middot;{" "}
            {t("footer.orgnr")} {site.orgnr}
          </span>
          <span>{addressLine}</span>
        </div>
      </div>
    </footer>

    <CookieConsent />

    <style is:global>
      html.nav-open,
      html.cc-open {
        overflow: hidden;
      }

      .main--offset {
        padding-top: var(--nav-h);
      }

      .foot__cookiebtn {
        font-size: var(--fs-sm);
        color: var(--on-dark-soft);
        padding: 0;
        text-align: left;
        transition: color var(--t-fast) var(--ease-out);
      }

      .foot__cookiebtn:hover {
        color: var(--on-dark);
      }
    </style>

    <script>
      /** Alt under kjører på nytt ved hver view transition. */
      function bindBurger() {
        const burger = document.querySelector<HTMLElement>("[data-burger]");
        const drawer = document.querySelector<HTMLElement>("[data-drawer]");
        if (!burger || burger.dataset.bound === "1") return;
        burger.dataset.bound = "1";

        const close = () => {
          document.documentElement.classList.remove("nav-open");
          burger.setAttribute("aria-expanded", "false");
          if (drawer) drawer.hidden = true;
        };

        burger.addEventListener("click", () => {
          const open = document.documentElement.classList.toggle("nav-open");
          burger.setAttribute("aria-expanded", String(open));
          if (drawer) drawer.hidden = !open;
        });

        drawer?.addEventListener("click", (e) => {
          if ((e.target as HTMLElement).tagName === "A") close();
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") close();
        });

        window.addEventListener("resize", () => {
          if (window.innerWidth > 1020) close();
        });
      }

      function closeDrawerOnNav() {
        document.documentElement.classList.remove("nav-open");
        const drawer = document.querySelector<HTMLElement>("[data-drawer]");
        if (drawer) drawer.hidden = true;
        const burger = document.querySelector<HTMLElement>("[data-burger]");
        burger?.setAttribute("aria-expanded", "false");
      }

      let observer: IntersectionObserver | null = null;

      function bindReveal() {
        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
        if (reduce) {
          items.forEach((el) => el.classList.add("is-in"));
          return;
        }
        observer?.disconnect();
        observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                observer?.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        items.forEach((el) => observer!.observe(el));
      }

      function bindNavScroll() {
        if ((window as any).__bmNavScroll) return;
        (window as any).__bmNavScroll = true;
        const update = () => {
          const n = document.querySelector(".nav");
          if (!n || n.classList.contains("nav--solid")) return;
          n.classList.toggle(
            "is-solid",
            window.scrollY > Math.min(window.innerHeight * 0.7, 560),
          );
        };
        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update, { passive: true });
        document.addEventListener("astro:page-load", update);
        update();
      }

      function bindCookieBtn() {
        document
          .querySelectorAll<HTMLElement>("[data-cookie-settings]")
          .forEach((b) => {
            if (b.dataset.bound === "1") return;
            b.dataset.bound = "1";
            b.addEventListener("click", () =>
              (window as any).bmOpenCookieSettings?.(),
            );
          });
      }

      function boot() {
        bindBurger();
        bindReveal();
        bindNavScroll();
        bindCookieBtn();
      }

      boot();
      document.addEventListener("astro:page-load", boot);
      document.addEventListener("astro:before-swap", closeDrawerOnNav);
    </script>
  </body>
</html>
