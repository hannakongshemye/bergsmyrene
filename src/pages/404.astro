---
import { Image } from "astro:assets";
import SiteLayout from "@layouts/SiteLayout.astro";
import Arrow from "@components/Arrow.astro";
import { getLangFromUrl, localizePath, useTranslations } from "@i18n/ui";
import { site } from "@data/site";

import img from "@assets/aker-duk.jpg";

const lang = getLangFromUrl(Astro.url);
const L = (p: string) => localizePath(p, lang);
const t = useTranslations(lang);

const s =
  lang === "en"
    ? {
        eyebrow: "404",
        title: "That page is out of season",
        lead: "The page you were looking for is not here. It may have moved when we rebuilt the site, or it was never here at all. Try one of these instead.",
        alt: "A person standing alone on a field covered with fleece",
        links: [
          { href: "/", label: "Front page" },
          { href: "/garden", label: "The farm" },
          { href: "/sesongen", label: "In season" },
          { href: "/besok-oss", label: "Visit us" },
          { href: "/bestill", label: "Order" },
          { href: "/kontakt", label: "Contact" },
        ],
        shop: "To the online shop",
      }
    : {
        eyebrow: "404",
        title: "Den siden er utenfor sesong",
        lead: "Siden du lette etter finnes ikke her. Kanskje den flyttet da vi bygde nettstedet på nytt, eller kanskje den aldri har vært her. Prøv en av disse i stedet.",
        alt: "En person står alene på et jorde dekket med duk",
        links: [
          { href: "/", label: "Forsiden" },
          { href: "/garden", label: "Gården" },
          { href: "/sesongen", label: "Sesongen" },
          { href: "/besok-oss", label: "Besøk oss" },
          { href: "/bestill", label: "Bestill" },
          { href: "/kontakt", label: "Kontakt" },
        ],
        shop: "Til nettbutikken",
      };
---

<SiteLayout title={s.eyebrow} description={s.lead}>
  <section class="section">
    <div class="wrap">
      <div class="split">
        <div>
          <p class="eyebrow">{s.eyebrow}</p>
          <h1 style="margin-block: var(--sp-3) var(--sp-5); max-width: 14ch;">{s.title}</h1>
          <p class="lead" style="margin-bottom: var(--sp-6);">{s.lead}</p>

          <ul class="links404">
            {
              s.links.map((l) => (
                <li>
                  <a href={L(l.href)}>
                    {l.label}
                    <Arrow />
                  </a>
                </li>
              ))
            }
          </ul>

          <p style="margin-top: var(--sp-6);">
            <a class="btn" href={site.shopUrl} rel="noopener" target="_blank">
              {s.shop}<Arrow class="btn__arrow" />
            </a>
          </p>
        </div>

        <figure class="imgfig">
          <Image
            src={img}
            alt={s.alt}
            widths={[560, 900, 1300]}
            sizes="(max-width: 860px) 92vw, 44vw"
            quality={76}
          />
        </figure>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .links404 {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 24rem;
  }

  .links404 li {
    border-top: 1px solid var(--rule);
  }

  .links404 li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .links404 a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-block: var(--sp-3);
    text-decoration: none;
    font-family: var(--ff-display);
    font-size: var(--fs-md);
    transition: padding-inline-start var(--t-fast) var(--ease-out);
  }

  .links404 a:hover {
    padding-inline-start: var(--sp-3);
  }

  .imgfig {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--surface-2);
  }

  .imgfig :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
