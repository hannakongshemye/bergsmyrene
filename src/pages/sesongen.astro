---
import SiteLayout from "@layouts/SiteLayout.astro";
import PageHero from "@components/PageHero.astro";
import SeasonWheel from "@components/SeasonWheel.astro";
import Arrow from "@components/Arrow.astro";
import { getLangFromUrl, localizePath } from "@i18n/ui";
import { getCrops, groupLabels, monthShort, getPhases } from "@data/season";
import { site } from "@data/site";

import heroImg from "@assets/purrefelt.jpg";

const lang = getLangFromUrl(Astro.url);
const L = (p: string) => localizePath(p, lang);

const crops = getCrops(lang);
const short = monthShort[lang];
const groups = groupLabels[lang];
const phases = getPhases(lang);

const order = ["blad", "urter", "drivhus", "rot", "annet"];
const byGroup = order
  .map((g) => ({ key: g, label: groups[g] ?? g, items: crops.filter((c) => c.group === g) }))
  .filter((g) => g.items.length > 0);

const s =
  lang === "en"
    ? {
        eyebrow: "In season",
        title: "Every vegetable has its window",
        lead: "Nature works in seasons, and so do we. All our produce comes out of natural processes and is not available all year round. We do our best to keep things going for as long as we can, but sometimes a season starts or stops suddenly.",
        heroAlt: "People working in a field of leeks in late summer",
        wheelEyebrow: "The farm year",
        wheelTitle: "Where we are right now",
        tableEyebrow: "Indicative",
        tableTitle: "Roughly when things are ready",
        tableLead:
          "A guide, not a promise. The exact window moves with the weather from one year to the next, and the farm confirms what is actually available.",
        draft: "Draft: the table below is indicative and is to be confirmed by the farm.",
        phasesTitle: "The four stretches of the year",
        shopCta: "To the online shop",
        visitCta: "Opening hours at the farm",
        legendHigh: "In season",
        legendOff: "Out of season",
      }
    : {
        eyebrow: "Sesongen",
        title: "Hver grønnsak har sitt vindu",
        lead: "Naturen jobber i sesonger, og det gjør vi også. Alt vi har er et resultat av naturlige prosesser og finnes ikke hele året. Vi gjør vårt beste for å ha ting tilgjengelig så lenge som mulig, men noen ganger starter eller stopper sesongen brått.",
        heroAlt: "Folk i arbeid i et purrefelt på sensommeren",
        wheelEyebrow: "Gårdsåret",
        wheelTitle: "Hvor vi er akkurat nå",
        tableEyebrow: "Veiledende",
        tableTitle: "Omtrent når ting er klart",
        tableLead:
          "En pekepinn, ikke et løfte. Vinduet flytter seg med været fra år til år, og det er gården som bekrefter hva som faktisk finnes.",
        draft: "Utkast: tabellen under er veiledende og skal bekreftes av gården.",
        phasesTitle: "De fire strekkene i året",
        shopCta: "Til nettbutikken",
        visitCta: "Åpningstider på gården",
        legendHigh: "I sesong",
        legendOff: "Utenfor sesong",
      };
---

<SiteLayout title={s.eyebrow} description={s.lead}>
  <PageHero
    eyebrow={s.eyebrow}
    title={s.title}
    lead={s.lead}
    image={heroImg}
    imageAlt={s.heroAlt}
  />

  <section class="section">
    <div class="wrap">
      <div class="sechead" data-reveal>
        <span class="eyebrow">{s.wheelEyebrow}</span>
        <span class="sechead__rule"></span>
      </div>
      <h2 style="margin-bottom: var(--sp-8);" data-reveal>{s.wheelTitle}</h2>
      <div data-reveal>
        <SeasonWheel />
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--surface);">
    <div class="wrap">
      <h2 style="margin-bottom: var(--sp-6);" data-reveal>{s.phasesTitle}</h2>
      <div class="grid grid--4">
        {
          phases.map((p, i) => (
            <div class="panel" data-reveal data-reveal-delay={String(i + 1)}>
              <p class="eyebrow">
                {short[p.months[0]! - 1]}
                {"–"}
                {short[p.months[p.months.length - 1]! - 1]}
              </p>
              <h3 class="card__title" style="margin-block: var(--sp-2) var(--sp-3);">
                {p.title}
              </h3>
              <p class="card__text">{p.lead}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sechead" data-reveal>
        <span class="eyebrow">{s.tableEyebrow}</span>
        <span class="sechead__rule"></span>
      </div>

      <div class="split split--wide-right" style="margin-bottom: var(--sp-5);">
        <h2 data-reveal>{s.tableTitle}</h2>
        <p class="lead" data-reveal data-reveal-delay="1">{s.tableLead}</p>
      </div>

      <p class="draftnote" data-reveal>{s.draft}</p>

      <div class="tablewrap" data-reveal>
        <table class="seasontable">
          <caption class="visually-hidden">{s.tableTitle}</caption>
          <thead>
            <tr>
              <th scope="col" class="seasontable__name"></th>
              {
                short.map((m) => (
                  <th scope="col">
                    <span class="m-long">{m}</span>
                    <span class="m-short" aria-hidden="true">{m.charAt(0).toUpperCase()}</span>
                  </th>
                ))
              }
            </tr>
          </thead>
          {
            byGroup.map((g) => (
              <tbody>
                <tr class="seasontable__grouprow">
                  <th scope="rowgroup" colspan="13">
                    {g.label}
                  </th>
                </tr>
                {g.items.map((c) => (
                  <tr>
                    <th scope="row" class="seasontable__name">
                      {c.name}
                    </th>
                    {Array.from({ length: 12 }, (_, i) => i + 1).map((m) => (
                      <td class={c.months.includes(m) ? "is-on" : ""}>
                        <span class="visually-hidden">
                          {short[m - 1]}: {c.months.includes(m) ? s.legendHigh : s.legendOff}
                        </span>
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>
      </div>

      <p class="seasontable__legend" data-reveal>
        <span class="swatch swatch--on"></span>{s.legendHigh}
        <span class="swatch"></span>{s.legendOff}
      </p>

      <p style="margin-top: var(--sp-7); display: flex; gap: var(--sp-3); flex-wrap: wrap;" data-reveal>
        <a class="btn" href={site.shopUrl} rel="noopener" target="_blank">
          {s.shopCta}<Arrow class="btn__arrow" />
        </a>
        <a class="btn btn--ghost" href={L("/besok-oss")}>{s.visitCta}</a>
      </p>
    </div>
  </section>
</SiteLayout>

<style>
  .draftnote {
    font-size: var(--fs-sm);
    color: color-mix(in oklab, var(--ember) 76%, var(--ink));
    background: color-mix(in oklab, var(--ember) 9%, transparent);
    border: 1px solid color-mix(in oklab, var(--ember) 28%, transparent);
    border-radius: var(--r-sm);
    padding: var(--sp-3) var(--sp-4);
    margin-bottom: var(--sp-5);
    max-width: var(--measure);
  }

  .tablewrap {
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    background: var(--surface);
  }

  .seasontable {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }

  .m-short {
    display: none;
  }

  /* Paa telefon krymper tabellen slik at hele aaret er synlig uten aa dra sidelengs. */
  @media (max-width: 760px) {
    .tablewrap {
      overflow-x: visible;
    }

    .seasontable {
      min-width: 0;
      font-size: var(--fs-xs);
    }

    .m-long {
      display: none;
    }

    .m-short {
      display: inline;
    }

    .seasontable__name {
      padding-left: var(--sp-3) !important;
      white-space: normal;
      width: auto;
      max-width: 8.5rem;
      line-height: 1.25;
    }

    .seasontable th,
    .seasontable td {
      padding: 0.4rem 0.08rem;
    }

    .seasontable td::after {
      inset: 26% 8%;
    }

    .seasontable td.is-on::after {
      inset: 18% 4%;
    }
  }

  .seasontable th,
  .seasontable td {
    text-align: center;
    padding: 0.5rem 0.2rem;
    border-bottom: 1px solid var(--rule);
  }

  .seasontable thead th {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
    padding-block: var(--sp-3);
  }

  .seasontable__name {
    text-align: left !important;
    font-weight: 400;
    padding-left: var(--sp-4) !important;
    white-space: nowrap;
    width: 1%;
  }

  .seasontable__grouprow th {
    text-align: left;
    padding: var(--sp-4) var(--sp-4) var(--sp-2);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--tr-meta);
    text-transform: uppercase;
    color: var(--fg-faint);
    border-bottom: 1px solid var(--rule-strong);
  }

  .seasontable td {
    position: relative;
    width: 7%;
  }

  .seasontable td::after {
    content: "";
    position: absolute;
    inset: 30% 12%;
    border-radius: 2px;
    background: color-mix(in oklab, var(--ink) 7%, transparent);
  }

  .seasontable td.is-on::after {
    background: var(--s-vekst);
    inset: 22% 6%;
  }

  .seasontable__legend {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-top: var(--sp-4);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .swatch {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    border-radius: 2px;
    background: color-mix(in oklab, var(--ink) 7%, transparent);
    margin-left: var(--sp-4);
  }

  .seasontable__legend .swatch:first-child {
    margin-left: 0;
  }

  .swatch--on {
    background: var(--s-vekst);
  }
</style>
