---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, title, lead, image, imageAlt = "" } = Astro.props;
---

<section class="phero">
  <div class="wrap">
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <h1 data-reveal data-reveal-delay="1">{title}</h1>
    {lead && <p class="lead phero__lead" data-reveal data-reveal-delay="2">{lead}</p>}
  </div>

  {
    image && (
      <figure class="phero__fig" data-reveal data-reveal-delay="2">
        <Image
          src={image}
          alt={imageAlt}
          widths={[800, 1400, 2000]}
          sizes="100vw"
          loading="eager"
          quality={78}
        />
      </figure>
    )
  }
</section>

<style>
  .phero {
    padding-top: var(--sp-8);
  }

  .phero h1 {
    margin-block: var(--sp-3) var(--sp-5);
    max-width: 18ch;
  }

  .phero__lead {
    font-size: var(--fs-md);
    max-width: 52ch;
  }

  .phero__fig {
    margin: var(--sp-8) 0 0;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    background: var(--surface-2);
  }

  .phero__fig :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 760px) {
    .phero__fig {
      aspect-ratio: 3 / 2;
    }
  }
</style>
