---
import { getLangFromUrl, localizePath } from "@i18n/ui";
import { site } from "@data/site";

const lang = getLangFromUrl(Astro.url);
const L = (p: string) => localizePath(p, lang);

const n = site.notice;
/** Beskjeden forsvinner av seg selv når until-datoen er passert. */
const expired = n.until ? new Date(n.until) < new Date() : false;
const show = n.active && !expired && (lang === "en" ? n.textEn : n.text);
const text = lang === "en" ? n.textEn : n.text;
---

{
  show && (
    <aside class="notice" data-notice>
      {n.href ? <a href={L(n.href)}>{text}</a> : text}
    </aside>
  )
}
