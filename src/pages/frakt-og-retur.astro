---
import SiteLayout from "@layouts/SiteLayout.astro";
import Arrow from "@components/Arrow.astro";
import { getLangFromUrl, localizePath } from "@i18n/ui";
import { site } from "@data/site";
import vilkar from "@data/vilkar.json";

const lang = getLangFromUrl(Astro.url);
const L = (p: string) => localizePath(p, lang);

const s =
  lang === "en"
    ? {
        eyebrow: "Delivery and returns",
        title: "Delivery and returns",
        lead: "What it costs, how it is sent, and what happens if something is wrong when the bag reaches you.",
        noteTitle: "In Norwegian",
        note: "The terms below are the binding Norwegian text. If anything is unclear, get in touch and we will explain it.",
        orderCta: "How ordering works",
        termsCta: "Full terms of sale",
      }
    : {
        eyebrow: "Frakt og retur",
        title: "Frakt og retur",
        lead: "Hva det koster, hvordan det sendes, og hva som skjer om noe er galt når posen kommer fram.",
        noteTitle: "",
        note: "",
        orderCta: "Slik bestiller du",
        termsCta: "Hele salgsbetingelsen",
      };
---

<SiteLayout title={s.title} description={s.lead}>
  <section class="section section--tight">
    <div class="wrap wrap--narrow">
      <p class="eyebrow" data-reveal>{s.eyebrow}</p>
      <h1 style="margin-block: var(--sp-3) var(--sp-5);" data-reveal data-reveal-delay="1">
        {s.title}
      </h1>
      <p class="lead" data-reveal data-reveal-delay="2">{s.lead}</p>

      {
        lang === "en" && (
          <div class="panel" style="margin-top: var(--sp-6);">
            <h2 class="card__title">{s.noteTitle}</h2>
            <p class="card__text" style="margin-top: var(--sp-3);">{s.note}</p>
          </div>
        )
      }
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap wrap--narrow">
      <div class="legal" lang="nb">
        {
          vilkar.fraktOgRetur.map((sec) => (
            <section>
              <h2>{sec.h}</h2>
              {sec.p.map((p) => (
                <p>{p}</p>
              ))}
            </section>
          ))
        }
      </div>

      <p style="margin-top: var(--sp-7); display: flex; gap: var(--sp-3); flex-wrap: wrap;" data-reveal>
        <a class="btn btn--ghost" href={L("/bestill")}>
          {s.orderCta}<Arrow class="btn__arrow" />
        </a>
        <a class="btn btn--ghost" href={L("/salgsbetingelser")}>{s.termsCta}</a>
      </p>

      <p class="formnote" style="margin-top: var(--sp-5);">
        {site.legalName}, {site.address.street}, {site.address.postalCode}{" "}
        {site.address.city}. {lang === "en" ? "Org. no." : "Org.nr."} {site.orgnr}.
      </p>
    </div>
  </section>
</SiteLayout>

<style>
  .legal section {
    margin-bottom: var(--sp-7);
  }

  .legal h2 {
    font-size: var(--fs-lg);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--sp-4);
  }

  .legal p {
    max-width: var(--measure);
    color: var(--fg-soft);
    margin-bottom: var(--sp-3);
  }
</style>
