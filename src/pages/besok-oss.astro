---
import { Image } from "astro:assets";
import SiteLayout from "@layouts/SiteLayout.astro";
import PageHero from "@components/PageHero.astro";
import Arrow from "@components/Arrow.astro";
import { getLangFromUrl, localizePath } from "@i18n/ui";
import { site, addressLine, mapsUrl } from "@data/site";
import hours from "@data/apningstider.json";

import heroImg from "@assets/vinke.jpg";
import solsikkeImg from "@assets/solsikke.jpg";

const lang = getLangFromUrl(Astro.url);
const L = (p: string) => localizePath(p, lang);

const s =
  lang === "en"
    ? {
        eyebrow: "Visit us",
        title: "The farm shop is open around the clock",
        lead: "You are welcome at Bergsmyrene. The farm shop is self-service and open all year. Through the summer the village store, the bakery and the pick-your-own flower garden are open too.",
        heroAlt: "Someone waving outside the red farm buildings at Bergsmyrene",
        hoursEyebrow: "Opening hours",
        hoursTitle: "What is open when",
        findEyebrow: "Finding us",
        findTitle: "Bergsmyrene 2, 3483 Kana",
        findLead:
          "The farm lies in Hurum, in Asker municipality. Come as you are, bring your own bag, and pay in the shop.",
        directions: "Open in Google Maps",
        callUs: "Call us",
        emailUs: "Send an email",
        flowersTitle: "Pick your own",
        flowersBody:
          "Through the summer the flower garden is open for picking. Take what you want and pay in the farm shop, like everything else here.",
        flowersAlt: "A sunflower in front of a farm wall",
        loose: "Loose weight, less packaging",
        looseBody:
          "We avoid plastic packaging wherever we can, and in the farm shop you can choose loose weight. Bring a bag or a box.",
        orderCta: "Order online instead",
        tbd: "Days vary with the season",
      }
    : {
        eyebrow: "Besøk oss",
        title: "Gårdsbutikken er åpen hele døgnet",
        lead: "Du er velkommen til Bergsmyrene. Gårdsbutikken er selvbetjent og åpen hele året. Om sommeren har vi også kolonial, bakeri og selvplukk i blomsterhagen.",
        heroAlt: "Noen vinker utenfor de røde gårdsbygningene på Bergsmyrene",
        hoursEyebrow: "Åpningstider",
        hoursTitle: "Hva som er åpent når",
        findEyebrow: "Finne fram",
        findTitle: "Bergsmyrene 2, 3483 Kana",
        findLead:
          "Gården ligger i Hurum, i Asker kommune. Kom som du er, ta med egen pose, og betal i butikken.",
        directions: "Åpne i Google Maps",
        callUs: "Ring oss",
        emailUs: "Send e-post",
        flowersTitle: "Selvplukk",
        flowersBody:
          "Om sommeren er blomsterhagen åpen for selvplukk. Ta det du vil ha og betal i gårdsbutikken, som alt annet her.",
        flowersAlt: "En solsikke foran en gårdsvegg",
        loose: "Løsvekt, mindre emballasje",
        looseBody:
          "Vi unngår plastemballasje der vi kan, og i gårdsbutikken kan du velge løsvekt. Ta med en pose eller en kasse.",
        orderCta: "Bestill på nett i stedet",
        tbd: "Dagene varierer med sesongen",
      };
---

<SiteLayout title={s.eyebrow} description={s.lead}>
  <PageHero
    eyebrow={s.eyebrow}
    title={s.title}
    lead={s.lead}
    image={heroImg}
    imageAlt={s.heroAlt}
  />

  <section class="section" id="apningstider">
    <div class="wrap">
      <div class="sechead" data-reveal>
        <span class="eyebrow">{s.hoursEyebrow}</span>
        <span class="sechead__rule"></span>
      </div>
      <h2 style="margin-bottom: var(--sp-7);" data-reveal>{s.hoursTitle}</h2>

      <div class="grid grid--2">
        {
          hours.steder.map((st, i) => (
            <article class="panel" data-reveal data-reveal-delay={String(Math.min(i + 1, 4))}>
              <header class="hourhead">
                <h3 class="card__title">{lang === "en" ? st.navnEn : st.navn}</h3>
                {st.alltidApen && <span class="tag tag--ember">{lang === "en" ? "Always open" : "Alltid åpen"}</span>}
              </header>
              <p class="card__text" style="margin-top: var(--sp-3);">
                {lang === "en" ? st.beskrivelseEn : st.beskrivelse}
              </p>
              <dl class="deflist" style="margin-top: var(--sp-4);">
                {st.tider.map((tid) => (
                  <div>
                    <dt>{lang === "en" ? tid.dagerEn : tid.dager}</dt>
                    <dd>{tid.tid || s.tbd}</dd>
                  </div>
                ))}
              </dl>
              {st.merknad && (
                <p class="formnote" style="margin-top: var(--sp-3);">
                  {lang === "en" ? st.merknadEn : st.merknad}
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--surface);">
    <div class="wrap">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">{s.findEyebrow}</p>
          <h2 style="margin-block: var(--sp-3) var(--sp-5);">{s.findTitle}</h2>
          <p class="lead" style="margin-bottom: var(--sp-5);">{s.findLead}</p>

          <dl class="deflist">
            <div>
              <dt>{lang === "en" ? "Address" : "Adresse"}</dt>
              <dd>{addressLine}</dd>
            </div>
            <div>
              <dt>{s.callUs}</dt>
              <dd><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></dd>
            </div>
            <div>
              <dt>{s.emailUs}</dt>
              <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
            </div>
          </dl>

          <p style="margin-top: var(--sp-5); display: flex; gap: var(--sp-3); flex-wrap: wrap;">
            <a class="btn" href={mapsUrl} rel="noopener" target="_blank">
              {s.directions}<Arrow class="btn__arrow" />
            </a>
            <a class="btn btn--ghost" href={L("/bestill")}>{s.orderCta}</a>
          </p>
        </div>

        <div class="grid" style="gap: var(--sp-5);" data-reveal data-reveal-delay="1">
          <figure class="imgfig">
            <Image
              src={solsikkeImg}
              alt={s.flowersAlt}
              widths={[560, 900, 1300]}
              sizes="(max-width: 860px) 92vw, 44vw"
              quality={78}
            />
          </figure>
          <div class="panel">
            <h3 class="card__title">{s.flowersTitle}</h3>
            <p class="card__text" style="margin-top: var(--sp-3);">{s.flowersBody}</p>
          </div>
          <div class="panel">
            <h3 class="card__title">{s.loose}</h3>
            <p class="card__text" style="margin-top: var(--sp-3);">{s.looseBody}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .hourhead {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    align-items: center;
    justify-content: space-between;
  }

  .imgfig {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--surface-2);
  }

  .imgfig :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
