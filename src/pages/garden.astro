---
import { Image } from "astro:assets";
import SiteLayout from "@layouts/SiteLayout.astro";
import PageHero from "@components/PageHero.astro";
import Arrow from "@components/Arrow.astro";
import { getLangFromUrl, localizePath } from "@i18n/ui";
import garden from "@data/garden.json";

import heroImg from "@assets/traktor-folk.jpg";
import teamImg from "@assets/teamet.jpg";
import kompostImg from "@assets/drivhus-kompost.jpg";
import kuImg from "@assets/ku.jpg";
import bonnerImg from "@assets/bonnehosting.jpg";

const lang = getLangFromUrl(Astro.url);
const L = (p: string) => localizePath(p, lang);

const s =
  lang === "en"
    ? {
        eyebrow: "The farm",
        title: "A market garden run biodynamically since 1981",
        lead: "Bergsmyrene produces organic, biodynamic vegetables in Hurum. Everything grown on the farm is sold locally, to families, shops and restaurants.",
        heroAlt: "A tractor and people working a freshly tilled field at Bergsmyrene",
        introEyebrow: "What is here",
        intro: [
          "On the farm we have a shop where you can buy our produce all year round. Through the summer we also have a flower garden you can pick from yourself, and a village store where we sell produce from other farms along with general organic staples. On top of that we have a small bakery with very good sourdough bread. Check the opening hours to find out when there is bread.",
          "We make a point of growing a broad range of common vegetables, but also greenhouse crops, herbs, berries and wild plants. In the high season, from July to September, we have nearly everything you could wish for in vegetables, plus a few you did not know you wanted. Do get in touch if you want something you cannot find in Norwegian shops. We will see what we can do.",
          "If you want something we grow but cannot get out to the farm, you can order it here on the site and have it delivered to your home or to a pickup point in Oslo and Drammen. Delivery is every Thursday.",
        ],
        philoEyebrow: "Philosophy and method",
        philoTitle: "Everything is only resources",
        philo: [
          "Our aim is to make genuinely sustainable, healthy and flavourful food. We achieve that by letting the biological processes steer the work we do on the farm. Fundamentally that means we only use natural materials to create the conditions our plants need to grow large and fine. And we would rather find those natural materials here on the farm.",
          "That is one reason we keep animals. The animals turn materials we cannot use ourselves into first-class plant nutrition. Their manure is also an important part of the composting we do. Into the compost we can add surplus from production, prunings and much more of what would otherwise be waste. In a natural system there is no waste; everything is only resources.",
          "That same biology happens to be exactly what plants need around their roots in order to take up nutrition from the soil in a natural way. By spreading compost we add nutrition and microbial life, which creates the conditions our plants need to grow large, strong and full of flavour. Then we eat the plants and put what we do not eat back into the compost, and there we have a fine circle going. A circle that, if we tend it well, can carry on forever. That is what we call sustainability.",
          "We also try to minimise our footprint by limiting the use of machinery and fossil fuel where we can. We avoid plastic packaging in both trade and private sales, and we give customers the option of loose weight in the farm shop.",
        ],
        historyEyebrow: "History",
        historyTitle: "From Finn to Severin",
        history: [
          "Bergsmyrene has been farmed biodynamically and organically since 1981, when Finn bought the farm and converted it to biodynamic methods. A few years later Evelyn Romer Iversen joined, and until 2022 the two of them ran the farm together. They had many irons in the fire over the years: many years of dairy production, later laying hens, and a range of animals and poultry including horses, sheep, goats, pigs, peacocks and geese. They also ran social projects, green care for people with functional variations, and school on the farm in various formats. The hen house was converted into a school kitchen, where we now cook for the farm's many trainees. In the beginning they also worked the soil with horses. And of course there has been vegetable production the whole time.",
          "In 2022 Severin officially bought the farm from Finn and Evelyn. That is how it works, even when it passes on within a family. Severin and Emma now officially run the farm. Beyond the formal ownership, not much has changed. We still work together in the same constellation as before. But Finn and Evelyn are slowly withdrawing, and Severin and Emma are starting their own projects. So far the bakery, the village store and the online shop are the biggest changes. Production carries on as before.",
        ],
        teamEyebrow: "The people",
        teamTitle: "Who is here",
        teamBody:
          "The farm is run by us, plus many willing hands who come and help for shorter spells in exchange for knowledge, board and lodging. We have had people from all over the world here over the years, and in the high season a great many want to come to us for adventure, a different kind of holiday, or to learn. The farm then turns into a teeming, living, cheerful camp with many languages and a great deal of life and bustle.",
        teamAlt: "Three of the people behind Bergsmyrene standing on the farm road",
        partnersEyebrow: "Farms we work with",
        partnersTitle: "What we do not grow ourselves",
        galleryCta: "See more from the farm",
      }
    : {
        eyebrow: "Gården",
        title: "En grønnsaksgård drevet biodynamisk siden 1981",
        lead: "Bergsmyrene gård er stolt produsent av økologisk biodynamiske grønnsaker. Alt som dyrkes på gården selges lokalt til familier, butikker og restauranter.",
        heroAlt: "Traktor og folk i arbeid på et nypløyd jorde på Bergsmyrene",
        introEyebrow: "Hva som finnes her",
        intro: [
          "På gården har vi en gårdsbutikk der det er mulig å handle varene våre hele året gjennom. Om sommeren har vi også en blomsterhage med selvplukk og en landhandel der vi selger varer fra andre gårder og generelle økologiske basisvarer. I tillegg til dette har vi et lite bakeri med deilig surdeigsbrød. Se åpningstidene for å finne ut av når vi har brød tilgjengelig.",
          "Vi legger vekt på å dyrke et bredt spekter av vanlige grønnsaker, men også drivhusvekster, urter, bær og ville vekster. I høysesongen, som er fra juli til september, har vi næsten alt man kan ønske seg av forskjellige grønnsaker, pluss noen man ikke visste at man ønsket seg. Ta gjerne kontakt om du ønsker deg noe som ikke finnes i norske butikker. Så skal vi se om vi får til noe.",
          "Om man ønsker seg noe av det vi dyrker, men ikke har mulighet til å komme ut til gården, er det mulig å bestille i nettbutikken og få det levert hjem eller til hentepunkter i Oslo og Drammen. Levering skjer hver torsdag.",
        ],
        philoEyebrow: "Filosofi og driftsform",
        philoTitle: "Alt er kun ressurser",
        philo: [
          "Vårt mål er å lage ekte bærekraftig, sunn og smakfull mat. Dette får vi til ved å la de biologiske prosessene styre arbeidet vi gjør på gården. Dette betyr grunnleggende sett at vi kun bruker naturlige materialer for å skape forholdene plantene våre trenger for å vokse seg store og fine. Og disse naturlige materialene skal vi helst også finne her på gården.",
          "Dette er en grunn til at vi har dyr på gården. Dyrene omdanner materialer vi ikke selv får brukt, til førsteklasses planternæring. Møkka fra dyrene er også en viktig del av komposteringen vi gjør på gården. I komposten kan vi tilsette overskudd fra produksjonen, planterester fra beskjæring og mye mer av det som ellers ville være avfall. I et naturlig system finnes det ikke avfall, alt er kun ressurser.",
          "Den samme biologien er tilfeldigvis også akkurat det planter trenger rundt røttene sine for å kunne ta opp næring fra jorda på en naturlig måte. Ved å spre kompost tilfører vi næring og mikroliv som skaper de betingelsene plantene våre trenger for å bli store, sterke og smakfulle. Så spiser vi plantene og putter det vi ikke spiser tilbake i komposten, og vips, så har vi en herlig sirkel gående. En sirkel som, om vi skjøtter den godt, vil kunne fortsette for alltid. Det kaller vi bærekraft.",
          "Videre forsøker vi å minimere avtrykket vårt ved å begrense bruken av maskiner og fossilt brennstoff der det er mulig. Vi unngår bruk av plastikk som emballasje både i proff- og privatsalg, og gir kunder muligheten til å velge løsvekt i gårdsbutikken.",
        ],
        historyEyebrow: "Historie",
        historyTitle: "Fra Finn til Severin",
        history: [
          "Bergsmyrene gård har vært drevet biodynamisk økologisk siden 1981, da Finn kjøpte gården og la den om til biodynamisk. Etter noen år kom Evelyn Romer Iversen til, og fram til 2022 drev de to gården sammen. De hadde mange jern i ilden gjennom årene. Både mange år med melkeproduksjon, etter hvert verpehøner, og mange forskjellige dyr og fjørfe som hest, sauer, geiter, gris, påfugl og gjess. De drev også med sosiale prosjekt som grønn omsorg for mennesker med funksjonsvariasjoner og skole på gården i forskjellige format. Hønsehuset ble bygget om til skolekjøkken, hvor vi nå lager mat til gårdens mange praktikanter. I starten drev de også jordbearbeiding med hest. Selvfølgelig har det hele tiden vært grønnsaksproduksjon.",
          "I 2022 kjøpte Severin gården offisielt av Finn og Evelyn. Det er slik det fungerer, også når det går videre i familien. Severin og Emma driver nå offisielt gården. Utover offisielt eierskap er det ikke så mye som har forandret seg. Vi driver fremdeles sammen i samme konstellasjon som tidligere. Men Finn og Evelyn trekker seg sakte, men sikkert ut, og Severin og Emma starter sine prosjekter. Inntil videre er det bakeriet, landhandelen og nettbutikken som er de største forandringene. Produksjonen går som før.",
        ],
        teamEyebrow: "Folkene",
        teamTitle: "Hvem som er her",
        teamBody:
          "Gården drives av oss pluss mange flittige hender som kommer og hjelper til i kortere perioder i bytte mot kunnskap, kost og losji. Vi har hatt mennesker fra hele verden innom i årenes løp, og i høysesong har vi veldig mange som vil komme til oss for eventyr, annerledes ferie eller læring. Da blir gården til en myldrende, levende, lystig leir med mange språk og mye liv og leven.",
        teamAlt: "Tre av menneskene bak Bergsmyrene står på gårdsveien",
        partnersEyebrow: "Gårder vi samarbeider med",
        partnersTitle: "Det vi ikke dyrker selv",
        galleryCta: "Se mer fra gården",
      };
---

<SiteLayout title={s.eyebrow} description={s.lead}>
  <PageHero
    eyebrow={s.eyebrow}
    title={s.title}
    lead={s.lead}
    image={heroImg}
    imageAlt={s.heroAlt}
  />

  <section class="section">
    <div class="wrap">
      <div class="split split--wide-right">
        <div data-reveal>
          <p class="eyebrow">{s.introEyebrow}</p>
        </div>
        <div class="prose" data-reveal data-reveal-delay="1">
          {s.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--surface);">
    <div class="wrap">
      <div class="split" style="margin-bottom: var(--sp-8);">
        <figure class="imgfig imgfig--4x5" data-reveal>
          <Image
            src={kompostImg}
            alt={lang === "en"
              ? "Two people spreading compost into a greenhouse bed"
              : "To personer sprer kompost i et bed inne i drivhuset"}
            widths={[560, 900, 1300]}
            sizes="(max-width: 860px) 92vw, 44vw"
            quality={78}
          />
        </figure>
        <div data-reveal data-reveal-delay="1">
          <p class="eyebrow">{s.philoEyebrow}</p>
          <h2 style="margin-block: var(--sp-3) var(--sp-5);">{s.philoTitle}</h2>
          <div class="prose">
            {s.philo.slice(0, 2).map((p) => <p>{p}</p>)}
          </div>
        </div>
      </div>

      <div class="split">
        <div class="prose" data-reveal>
          {s.philo.slice(2).map((p) => <p>{p}</p>)}
        </div>
        <figure class="imgfig imgfig--4x3" data-reveal data-reveal-delay="1">
          <Image
            src={kuImg}
            alt={lang === "en"
              ? "A cow looking straight into the camera"
              : "En ku som ser rett i kamera"}
            widths={[560, 900, 1300]}
            sizes="(max-width: 860px) 92vw, 44vw"
            quality={78}
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sechead" data-reveal>
        <span class="eyebrow">{s.historyEyebrow}</span>
        <span class="sechead__rule"></span>
      </div>
      <div class="split split--wide-right">
        <h2 data-reveal>{s.historyTitle}</h2>
        <div class="prose" data-reveal data-reveal-delay="1">
          {s.history.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section" data-dark>
    <div class="wrap">
      <div class="sechead" data-reveal>
        <span class="eyebrow">{s.teamEyebrow}</span>
        <span class="sechead__rule"></span>
      </div>

      <div class="split split--wide-right" style="margin-bottom: var(--sp-7);">
        <h2 data-reveal>{s.teamTitle}</h2>
        <p class="lead" data-reveal data-reveal-delay="1">{s.teamBody}</p>
      </div>

      <dl class="deflist" data-reveal>
        {
          garden.team.map((m) => (
            <div>
              <dt style="font-family: var(--ff-display); font-size: var(--fs-lg);">
                {m.navn}
              </dt>
              <dd>{lang === "en" ? m.rolleEn : m.rolle}</dd>
            </div>
          ))
        }
      </dl>

      <figure class="imgfig imgfig--wide" style="margin-top: var(--sp-7);" data-reveal>
        <Image
          src={teamImg}
          alt={s.teamAlt}
          widths={[800, 1400, 2000]}
          sizes="(max-width: 1200px) 94vw, 76rem"
          quality={78}
        />
      </figure>
    </div>
  </section>

  <section class="section" id="samarbeid">
    <div class="wrap">
      <div class="sechead" data-reveal>
        <span class="eyebrow">{s.partnersEyebrow}</span>
        <span class="sechead__rule"></span>
      </div>
      <h2 style="margin-bottom: var(--sp-6);" data-reveal>{s.partnersTitle}</h2>

      <div class="grid grid--3">
        {
          garden.samarbeidsgarder.map((g, i) => (
            <div class="panel" data-reveal data-reveal-delay={String(i + 1)}>
              <h3 class="card__title">{g.navn}</h3>
              <p class="eyebrow" style="margin-block: var(--sp-2) var(--sp-3);">
                {g.sted}
              </p>
              <p class="card__text">{lang === "en" ? g.tekstEn : g.tekst}</p>
              {g.url && (
                <p style="margin-top: var(--sp-4);">
                  <a class="tlink" href={g.url} rel="noopener" target="_blank">
                    {g.url.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                    <Arrow />
                  </a>
                </p>
              )}
            </div>
          ))
        }
      </div>

      <figure class="imgfig imgfig--wide" style="margin-top: var(--sp-8);" data-reveal>
        <Image
          src={bonnerImg}
          alt={lang === "en"
            ? "Two people picking beans from tall climbing plants"
            : "To personer plukker bønner fra høye klatreplanter"}
          widths={[800, 1400, 2000]}
          sizes="(max-width: 1200px) 94vw, 76rem"
          quality={76}
        />
      </figure>

      <p style="margin-top: var(--sp-6);" data-reveal>
        <a class="btn btn--ghost" href={L("/galleri")}>
          {s.galleryCta}<Arrow class="btn__arrow" />
        </a>
      </p>
    </div>
  </section>
</SiteLayout>

<style>
  .imgfig {
    margin: 0;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--surface-2);
  }

  .imgfig :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .imgfig--4x5 {
    aspect-ratio: 4 / 5;
  }

  .imgfig--4x3 {
    aspect-ratio: 4 / 3;
  }

  .imgfig--wide {
    aspect-ratio: 21 / 9;
  }

  @media (max-width: 760px) {
    .imgfig--wide {
      aspect-ratio: 3 / 2;
    }
  }
</style>
