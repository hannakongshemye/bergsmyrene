---
import { Image } from "astro:assets";
import SiteLayout from "@layouts/SiteLayout.astro";
import type { ImageMetadata } from "astro";
import { getLangFromUrl } from "@i18n/ui";

import droneTunet from "@assets/drone-tunet.jpg";
import heroDalen from "@assets/hero-dalen.jpg";
import hesje from "@assets/hesje.jpg";
import teamet from "@assets/teamet.jpg";
import traktorStov from "@assets/traktor-stov.jpg";
import traktorFolk from "@assets/traktor-folk.jpg";
import traktorVei from "@assets/traktor-vei.jpg";
import kjerreLave from "@assets/kjerre-lave.jpg";
import drivhusKompost from "@assets/drivhus-kompost.jpg";
import drivhusSalat from "@assets/drivhus-salat.jpg";
import akerDuk from "@assets/aker-duk.jpg";
import bonnehosting from "@assets/bonnehosting.jpg";
import purre from "@assets/purre.jpg";
import purrefelt from "@assets/purrefelt.jpg";
import gulrotKasser from "@assets/gulrot-kasser.jpg";
import gulrotOpptak from "@assets/gulrot-opptak.jpg";
import kasser from "@assets/kasser.jpg";
import kveldIAkeren from "@assets/kveld-i-akeren.jpg";
import jordIHanda from "@assets/jord-i-handa.jpg";
import ku from "@assets/ku.jpg";
import hest from "@assets/hest.jpg";
import hestOgRytter from "@assets/hest-og-rytter.jpg";
import hone from "@assets/hone.jpg";
import solsikke from "@assets/solsikke.jpg";
import sprang from "@assets/sprang.jpg";
import spade from "@assets/spade.jpg";
import rorVedLave from "@assets/ror-ved-lave.jpg";
import hakke from "@assets/hakke.jpg";
import portrettSkjerf from "@assets/portrett-skjerf.jpg";
import vinke from "@assets/vinke.jpg";

const lang = getLangFromUrl(Astro.url);

type Shot = { src: ImageMetadata; no: string; en: string; wide?: boolean; foto?: string };

const shots: Shot[] = [
  { src: heroDalen, no: "Dalen med gården sett ovenfra en sommerkveld", en: "The valley with the farm seen from above on a summer evening", wide: true, foto: "Troels Rosenkranz" },
  { src: drivhusKompost, no: "To personer sprer kompost i et bed inne i drivhuset", en: "Two people spreading compost into a greenhouse bed" },
  { src: drivhusSalat, no: "Rader med ung salat og oppal i drivhuset", en: "Rows of young lettuce and seedlings in the greenhouse" },
  { src: akerDuk, no: "En person står alene på et jorde dekket med duk", en: "A person standing alone on a field covered with fleece", foto: "Jule Mehrhoff" },
  { src: traktorStov, no: "Traktoren jobber i støvskyen på et nypløyd jorde", en: "The tractor working in a cloud of dust on a freshly ploughed field", wide: true, foto: "Jule Mehrhoff" },
  { src: bonnehosting, no: "To personer plukker bønner fra høye klatreplanter", en: "Two people picking beans from tall climbing plants", foto: "Scott Gilmour" },
  { src: purre, no: "En person bærer et stort fang med nyhøstet purre", en: "A person carrying a large armful of freshly harvested leeks", foto: "Scott Gilmour" },
  { src: purrefelt, no: "Folk i arbeid i purrefeltet", en: "People working in the leek field", foto: "Scott Gilmour" },
  { src: gulrotOpptak, no: "Gulrøtter tas opp av jorda for hånd", en: "Carrots being lifted from the soil by hand", foto: "Scott Gilmour" },
  { src: gulrotKasser, no: "Nyopptatte gulrøtter pakkes i grønne kasser", en: "Freshly pulled carrots being packed into green crates", foto: "Scott Gilmour" },
  { src: kasser, no: "Kasser med grønnsaker lastes opp på en henger", en: "Crates of vegetables being loaded onto a trailer", foto: "Scott Gilmour" },
  { src: jordIHanda, no: "Nærbilde av mørk, smuldrete jord i en hånd", en: "A close-up of dark, crumbly soil in a hand", foto: "Scott Gilmour" },
  { src: kveldIAkeren, no: "En bønde i silhuett mot kveldshimmelen under innhøsting", en: "A farmer silhouetted against the evening sky while harvesting", wide: true, foto: "Scott Gilmour" },
  { src: ku, no: "En ku som ser rett i kamera", en: "A cow looking straight into the camera", foto: "Scott Gilmour" },
  { src: hest, no: "En hest i døra til stallen", en: "A horse in the stable doorway", foto: "Jule Mehrhoff" },
  { src: hestOgRytter, no: "En av oss leier hesten ut på tunet", en: "One of us leading the horse out into the yard", foto: "Jule Mehrhoff" },
  { src: hone, no: "Nærbilde av en høne", en: "A close-up of a hen" },
  { src: hesje, no: "Høyånn med hesje på jordet", en: "Haymaking with traditional drying racks in the field" },
  { src: teamet, no: "Tre av menneskene bak Bergsmyrene står på gårdsveien", en: "Three of the people behind Bergsmyrene standing on the farm road", wide: true, foto: "Scott Gilmour" },
  { src: sprang, no: "Et hopp midt på gårdsveien", en: "A jump in the middle of the farm road", foto: "Jule Mehrhoff" },
  { src: spade, no: "Spaden settes i jorda", en: "A spade going into the soil", foto: "Jule Mehrhoff" },
  { src: hakke, no: "Hakka hviler mellom to bed", en: "A hoe resting between two beds", foto: "Jule Mehrhoff" },
  { src: rorVedLave, no: "Arbeid med rør utenfor den røde låven", en: "Working with pipes outside the red barn", foto: "Jule Mehrhoff" },
  { src: portrettSkjerf, no: "Portrett i skumringen, med skjerf og ullgenser", en: "A portrait in the half-light, in scarf and wool jumper", foto: "Jule Mehrhoff" },
  { src: traktorFolk, no: "Traktor og folk i arbeid på et nypløyd jorde", en: "A tractor and people working a freshly tilled field", foto: "Jule Mehrhoff" },
  { src: traktorVei, no: "Traktoren på vei opp gårdsveien", en: "The tractor coming up the farm road", foto: "Scott Gilmour" },
  { src: kjerreLave, no: "En kjerre trilles forbi den gamle låven", en: "A cart being wheeled past the old barn", foto: "Scott Gilmour" },
  { src: vinke, no: "Noen vinker utenfor de røde gårdsbygningene", en: "Someone waving outside the red farm buildings", foto: "Scott Gilmour" },
  { src: solsikke, no: "En solsikke foran en gårdsvegg", en: "A sunflower in front of a farm wall" },
  { src: droneTunet, no: "Gårdstunet sett fra lufta, med åkerbed og drivhus", en: "The farmyard from the air, with field beds and greenhouses", wide: true, foto: "Oelle" },
];

const items = shots;

const s =
  lang === "en"
    ? {
        eyebrow: "Gallery",
        title: "Pictures from the farm",
        lead: "A year at Bergsmyrene, from compost in the greenhouse in spring to the last roots coming in before the frost.",
        photo: "Photo",
        credits: "Photography",
        creditsBody:
          "Pictures on this page are by Scott Gilmour, Jule Mehrhoff, Troels Rosenkranz and Oelle, along with the farm's own snapshots.",
      }
    : {
        eyebrow: "Galleri",
        title: "Bilder fra gården",
        lead: "Et år på Bergsmyrene, fra kompost i drivhuset om våren til de siste røttene som kommer inn før frosten.",
        photo: "Foto",
        credits: "Fotografer",
        creditsBody:
          "Bildene på denne siden er tatt av Scott Gilmour, Jule Mehrhoff, Troels Rosenkranz og Oelle, i tillegg til gårdens egne bilder.",
      };
---

<SiteLayout title={s.eyebrow} description={s.lead}>
  <section class="section section--tight">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{s.eyebrow}</p>
      <h1 style="margin-block: var(--sp-3) var(--sp-5);" data-reveal data-reveal-delay="1">
        {s.title}
      </h1>
      <p class="lead" data-reveal data-reveal-delay="2">{s.lead}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="gal">
        {
          items.map((it, i) => (
            <figure
              class={`gal__item${it.wide ? " gal__item--wide" : ""}`}
              data-reveal
              data-reveal-delay={String((i % 3) + 1)}
            >
              <Image
                src={it.src}
                alt={lang === "en" ? it.en : it.no}
                widths={it.wide ? [700, 1200, 1800] : [420, 700, 1100]}
                sizes={it.wide
                  ? "(max-width: 760px) 92vw, 64vw"
                  : "(max-width: 760px) 92vw, 32vw"}
                quality={76}
                loading={i < 3 ? "eager" : "lazy"}
              />
              {it.foto && (
                <figcaption>
                  {s.photo}: {it.foto}
                </figcaption>
              )}
            </figure>
          ))
        }
      </div>

      <div class="panel" style="margin-top: var(--sp-8); max-width: var(--measure);" data-reveal>
        <h2 class="card__title">{s.credits}</h2>
        <p class="card__text" style="margin-top: var(--sp-3);">{s.creditsBody}</p>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .gal {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-4);
  }

  @media (max-width: 760px) {
    .gal {
      grid-template-columns: 1fr;
    }
  }

  .gal__item {
    margin: 0;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--surface-2);
  }

  .gal__item--wide {
    grid-column: span 2;
    aspect-ratio: 8 / 5;
  }

  @media (max-width: 760px) {
    .gal__item--wide {
      grid-column: span 1;
      aspect-ratio: 3 / 2;
    }
  }

  .gal__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .gal__item:hover :global(img) {
    transform: scale(1.04);
  }

  .gal__item figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--sp-5) var(--sp-4) var(--sp-3);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: color-mix(in oklab, var(--paper) 86%, transparent);
    background: linear-gradient(
      180deg,
      transparent,
      color-mix(in oklab, var(--ink) 64%, transparent)
    );
    opacity: 0;
    transition: opacity var(--t-mid) var(--ease-out);
  }

  .gal__item:hover figcaption,
  .gal__item:focus-within figcaption {
    opacity: 1;
  }
</style>
