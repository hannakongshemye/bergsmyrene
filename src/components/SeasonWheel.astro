---
import { getLangFromUrl } from "@i18n/ui";
import { getPhases, monthNames, monthShort } from "@data/season";

interface Props {
  /** Vis fasebeskrivelsen ved siden av hjulet */
  withLead?: boolean;
}
const { withLead = true } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const phases = getPhases(lang);
const names = monthNames[lang];
const short = monthShort[lang];

/** Måned (1-12) -> fase */
const phaseOf: Record<number, (typeof phases)[number]> = {};
for (const p of phases) for (const m of p.months) phaseOf[m] = p;

const C = 220; // sentrum
const R_OUT = 168;
const R_IN = 124;
const R_LABEL = 201;
const GAP = 1.6; // grader mellom segmentene

const rad = (deg: number) => ((deg - 90) * Math.PI) / 180;
const pt = (r: number, deg: number) => [
  (C + r * Math.cos(rad(deg))).toFixed(2),
  (C + r * Math.sin(rad(deg))).toFixed(2),
];

function wedge(month: number, rOut = R_OUT, rIn = R_IN) {
  const a0 = (month - 1) * 30 + GAP / 2;
  const a1 = month * 30 - GAP / 2;
  const [x0o, y0o] = pt(rOut, a0);
  const [x1o, y1o] = pt(rOut, a1);
  const [x1i, y1i] = pt(rIn, a1);
  const [x0i, y0i] = pt(rIn, a0);
  return `M ${x0o} ${y0o} A ${rOut} ${rOut} 0 0 1 ${x1o} ${y1o} L ${x1i} ${y1i} A ${rIn} ${rIn} 0 0 0 ${x0i} ${y0i} Z`;
}

const months = Array.from({ length: 12 }, (_, i) => i + 1);

const fill: Record<string, string> = {
  hvile: "var(--s-hvile)",
  oppal: "var(--s-spire)",
  hoysesong: "var(--s-vekst)",
  lagring: "var(--s-host)",
};

/** Data som klienten trenger for å sette riktig måned med ekte klokke. */
const clientData = months.map((m) => ({
  m,
  name: names[m - 1],
  title: phaseOf[m]!.title,
  lead: phaseOf[m]!.lead,
}));

const s =
  lang === "en"
    ? { eyebrow: "The farm year", now: "Right now", aria: "The farm year in twelve months" }
    : { eyebrow: "Gårdsåret", now: "Akkurat nå", aria: "Gårdsåret i tolv måneder" };

// Byggetidspunktets måned er bare et startpunkt, klienten overstyrer.
const buildMonth = new Date().getMonth() + 1;
---

<div class="wheelblock" data-wheel>
  <figure class="wheel">
    <svg viewBox="0 0 440 440" role="img" aria-label={s.aria}>
      <g class="wheel__ring">
        {
          months.map((m) => (
            <path
              d={wedge(m)}
              fill={fill[phaseOf[m]!.key]}
              data-month={m}
              class="wheel__seg"
              style={`--i:${m - 1}`}
            />
          ))
        }
      </g>

      <g class="wheel__marks">
        {
          months.map((m) => {
            const [x, y] = pt(R_LABEL, (m - 1) * 30 + 15);
            return (
              <text
                x={x}
                y={y}
                data-month-label={m}
                class="wheel__label"
                text-anchor="middle"
                dominant-baseline="middle"
              >
                {short[m - 1]}
              </text>
            );
          })
        }
      </g>

      <g class="wheel__needle" data-needle transform={`rotate(${(buildMonth - 1) * 30 + 15} ${C} ${C})`}>
        <line x1={C} y1={C - R_IN + 12} x2={C} y2={C - R_OUT - 3} />
        <circle cx={C} cy={C - R_IN + 16} r="3" />
      </g>

      <text class="wheel__now" x={C} y={C - 16} text-anchor="middle">{s.now}</text>
      <text class="wheel__month" x={C} y={C + 26} text-anchor="middle" data-wheel-month>
        {names[buildMonth - 1]}
      </text>
    </svg>
  </figure>

  {
    withLead && (
      <div class="wheel__copy">
        <p class="eyebrow">{s.eyebrow}</p>
        <h3 class="wheel__phase" data-wheel-title>
          {phaseOf[buildMonth]!.title}
        </h3>
        <p class="wheel__lead" data-wheel-lead>
          {phaseOf[buildMonth]!.lead}
        </p>
        <ul class="wheel__legend">
          {phases.map((p) => (
            <li>
              <span class="wheel__dot" style={`background:${fill[p.key]}`} />
              {p.title}
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <script
    type="application/json"
    data-wheel-data
    is:inline
    set:html={JSON.stringify(clientData)}
  />
</div>

<style>
  .wheelblock {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sp-8);
    align-items: center;
  }

  @media (max-width: 900px) {
    .wheelblock {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }
  }

  .wheel {
    margin: 0;
    max-width: 30rem;
    justify-self: center;
    width: 100%;
  }

  .wheel__seg {
    transition: opacity var(--t-mid) var(--ease-out),
      transform var(--t-mid) var(--ease-out);
    transform-origin: 220px 220px;
    opacity: 0.55;
  }

  .wheel__seg.is-now {
    opacity: 1;
  }

  .wheel__ring:hover .wheel__seg {
    opacity: 0.4;
  }

  .wheel__ring .wheel__seg:hover,
  .wheel__ring:hover .wheel__seg.is-now {
    opacity: 1;
  }

  .wheel__label {
    font-family: var(--ff-sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--fg-faint);
    transition: fill var(--t-fast) var(--ease-out);
  }

  .wheel__label.is-now {
    fill: var(--ink);
  }

  .wheel__needle line {
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .wheel__needle circle {
    fill: var(--ink);
  }

  .wheel__needle {
    transition: transform 1.4s var(--ease-out);
  }

  .wheel__now {
    font-family: var(--ff-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    fill: var(--fg-faint);
  }

  .wheel__month {
    font-family: var(--ff-display);
    font-size: 40px;
    font-weight: 400;
    fill: var(--ink);
  }

  .wheel__phase {
    font-size: var(--fs-xl);
    margin-block: var(--sp-3) var(--sp-4);
  }

  .wheel__lead {
    color: var(--fg-soft);
    max-width: 40ch;
    font-size: var(--fs-md);
  }

  .wheel__legend {
    list-style: none;
    padding: 0;
    margin-top: var(--sp-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-5);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .wheel__legend li {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  .wheel__dot {
    width: 0.7em;
    height: 0.7em;
    border-radius: 2px;
    display: inline-block;
  }

  /* Signaturbevegelsen: hjulet tegner seg én gang */
  @media (prefers-reduced-motion: no-preference) {
    .wheelblock[data-anim] .wheel__seg {
      animation: segIn 0.5s var(--ease-out) backwards;
      animation-delay: calc(var(--i) * 0.045s);
    }
    .wheelblock[data-anim] .wheel__needle {
      animation: needleIn 1.5s var(--ease-out) backwards;
    }
  }

  @keyframes segIn {
    from {
      opacity: 0;
      transform: scale(0.84);
    }
  }

  @keyframes needleIn {
    from {
      transform: rotate(0deg);
    }
  }
</style>

<script>
  function bootWheel() {
    document.querySelectorAll<HTMLElement>("[data-wheel]").forEach((root) => {
      const raw = root.querySelector("[data-wheel-data]")?.textContent;
      if (!raw) return;

      let data: { m: number; name: string; title: string; lead: string }[];
      try {
        data = JSON.parse(raw);
      } catch {
        return;
      }

      // Ekte klokke, ikke byggetidspunktet.
      const now = new Date().getMonth() + 1;
      const entry = data.find((d) => d.m === now);
      if (!entry) return;

      root
        .querySelectorAll<SVGElement>(".wheel__seg")
        .forEach((el) =>
          el.classList.toggle("is-now", el.dataset.month === String(now)),
        );
      root
        .querySelectorAll<SVGElement>("[data-month-label]")
        .forEach((el) =>
          el.classList.toggle(
            "is-now",
            el.getAttribute("data-month-label") === String(now),
          ),
        );

      const needle = root.querySelector<SVGElement>("[data-needle]");
      needle?.setAttribute(
        "transform",
        `rotate(${(now - 1) * 30 + 15} 220 220)`,
      );

      const setText = (sel: string, value: string) => {
        const el = root.querySelector(sel);
        if (el) el.textContent = value;
      };
      setText("[data-wheel-month]", entry.name);
      setText("[data-wheel-title]", entry.title);
      setText("[data-wheel-lead]", entry.lead);

      // Spill signaturbevegelsen én gang per besøk på siden.
      if (!root.hasAttribute("data-anim")) {
        root.setAttribute("data-anim", "");
      }
    });
  }

  bootWheel();
  document.addEventListener("astro:page-load", bootWheel);
</script>
