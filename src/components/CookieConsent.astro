---
import { getLangFromUrl, localizePath } from "@i18n/ui";

const lang = getLangFromUrl(Astro.url);
const L = (p: string) => localizePath(p, lang);

const s =
  lang === "en"
    ? {
        title: "Cookies on bergsmyrene.no",
        body: "We use a few necessary cookies to make the site work. With your consent we also measure visits, so we can see which pages are useful. Nothing is shared for advertising.",
        necessary: "Necessary only",
        accept: "Accept all",
        stats: "Statistics",
        statsHelp: "Anonymous visit measurement (Google Analytics)",
        necessaryLabel: "Necessary",
        necessaryHelp: "Always on. Needed for the site to work.",
        save: "Save choice",
        more: "Read the privacy policy",
        settingsTitle: "Cookie settings",
      }
    : {
        title: "Informasjonskapsler på bergsmyrene.no",
        body: "Vi bruker noen nødvendige informasjonskapsler for at siden skal virke. Med samtykket ditt måler vi også besøk, slik at vi ser hvilke sider som er til nytte. Ingenting deles til annonsering.",
        necessary: "Bare nødvendige",
        accept: "Godta alle",
        stats: "Statistikk",
        statsHelp: "Anonym besøksmåling (Google Analytics)",
        necessaryLabel: "Nødvendige",
        necessaryHelp: "Alltid på. Trengs for at siden skal virke.",
        save: "Lagre valg",
        more: "Les personvernerklæringen",
        settingsTitle: "Innstillinger for informasjonskapsler",
      };
---

<div
  class="cc"
  data-cc
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="cc-title"
  aria-describedby="cc-body"
  tabindex="-1"
>
  <div class="cc__panel">
    <h2 class="cc__title" id="cc-title" data-cc-title>{s.title}</h2>
    <p class="cc__body" id="cc-body">{s.body}</p>

    <div class="cc__opts" data-cc-opts hidden>
      <label class="cc__opt">
        <input type="checkbox" checked disabled />
        <span>
          <strong>{s.necessaryLabel}</strong>
          <small>{s.necessaryHelp}</small>
        </span>
      </label>
      <label class="cc__opt">
        <input type="checkbox" data-cc-stats />
        <span>
          <strong>{s.stats}</strong>
          <small>{s.statsHelp}</small>
        </span>
      </label>
    </div>

    <div class="cc__actions">
      <button class="btn btn--ghost" data-cc-necessary>{s.necessary}</button>
      <button class="btn" data-cc-accept>{s.accept}</button>
      <button class="btn" data-cc-save hidden>{s.save}</button>
    </div>

    <a class="cc__more" href={L("/personvern")}>{s.more}</a>
  </div>
</div>

<style>
  .cc {
    position: fixed;
    inset: 0;
    z-index: 4000;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: var(--gutter);
    background: color-mix(in oklab, var(--ink) 48%, transparent);
    backdrop-filter: blur(2px);
  }

  .cc[hidden] {
    display: none;
  }

  .cc__panel {
    width: min(100%, 34rem);
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    border-radius: var(--r-lg);
    padding: var(--sp-6);
    display: grid;
    gap: var(--sp-4);
    box-shadow: 0 32px 70px -40px rgba(10, 14, 9, 0.6);
  }

  .cc__title {
    font-size: var(--fs-lg);
  }

  .cc__body {
    font-size: var(--fs-sm);
    color: var(--fg-soft);
    margin: 0;
  }

  .cc__opts {
    display: grid;
    gap: var(--sp-3);
    padding-block: var(--sp-2);
    border-block: 1px solid var(--rule);
  }

  .cc__opts[hidden] {
    display: none;
  }

  .cc__opt {
    display: flex;
    gap: var(--sp-3);
    align-items: start;
    font-size: var(--fs-sm);
  }

  .cc__opt input {
    margin-top: 0.35em;
    accent-color: var(--ember);
  }

  .cc__opt span {
    display: grid;
    gap: 0.15em;
  }

  .cc__opt small {
    color: var(--fg-faint);
    font-size: var(--fs-xs);
  }

  .cc__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  .cc__actions .btn {
    flex: 1 1 auto;
    justify-content: center;
  }

  .cc__actions [hidden] {
    display: none;
  }

  .cc__more {
    font-size: var(--fs-xs);
    color: var(--fg-faint);
  }

  @media (min-width: 640px) {
    .cc {
      align-items: center;
    }
  }
</style>

<script>
  type Consent = {
    v: number;
    necessary: boolean;
    statistics: boolean;
    ts: string;
  };

  const KEY = "bm-consent";

  function boot() {
    const el = document.querySelector<HTMLElement>("[data-cc]");
    if (!el || el.dataset.bound === "1") return;
    el.dataset.bound = "1";

    const opts = el.querySelector<HTMLElement>("[data-cc-opts]");
    const statsBox = el.querySelector<HTMLInputElement>("[data-cc-stats]");
    const saveBtn = el.querySelector<HTMLElement>("[data-cc-save]");
    const acceptBtn = el.querySelector<HTMLElement>("[data-cc-accept]");
    const necBtn = el.querySelector<HTMLElement>("[data-cc-necessary]");

    let lastFocus: HTMLElement | null = null;

    const read = (): Consent | null => {
      try {
        return JSON.parse(localStorage.getItem(KEY) || "null");
      } catch {
        return null;
      }
    };

    const publish = (c: Consent) => {
      (window as any).__consent = c;
      document.dispatchEvent(new CustomEvent("bm:consent", { detail: c }));
    };

    const hide = () => {
      el.hidden = true;
      document.documentElement.classList.remove("cc-open");
      lastFocus?.focus();
    };

    const show = (settings = false) => {
      lastFocus = document.activeElement as HTMLElement;
      if (opts) opts.hidden = !settings;
      if (saveBtn) saveBtn.hidden = !settings;
      if (acceptBtn) acceptBtn.hidden = settings;
      if (statsBox) statsBox.checked = read()?.statistics ?? false;
      el.hidden = false;
      document.documentElement.classList.add("cc-open");
      window.setTimeout(() => el.focus(), 50);
    };

    const store = (statistics: boolean) => {
      const c: Consent = {
        v: 1,
        necessary: true,
        statistics,
        ts: new Date().toISOString(),
      };
      try {
        localStorage.setItem(KEY, JSON.stringify(c));
      } catch {}
      publish(c);
      hide();
    };

    acceptBtn?.addEventListener("click", () => store(true));
    necBtn?.addEventListener("click", () => store(false));
    saveBtn?.addEventListener("click", () => store(!!statsBox?.checked));
    el.addEventListener("click", (e) => {
      if (e.target === el) store(false);
    });
    el.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Escape") store(false);
    });

    (window as any).bmOpenCookieSettings = () => show(true);

    const existing = read();
    if (existing) {
      publish(existing);
      hide();
    } else {
      show(false);
    }
  }

  boot();
  document.addEventListener("astro:page-load", boot);
</script>
